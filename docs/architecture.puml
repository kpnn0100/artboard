@startuml
title Arstro Artboard Architecture
skinparam classAttributeIconSize 0
hide empty members

package core {
  class Point
  class Size
  class Rect
  class Transform
  class Color
}

package anim {
  enum Easing
  class Animation
  class Tween
  class AnimatedProperty
  class Animator
  Animation ..> Easing
  Tween ..> Easing
  AnimatedProperty *--> Tween
  Animator *--> Tween
}

package render {
  interface IRenderTarget
  class RecordingTarget
  RecordingTarget ..|> IRenderTarget
}

package input {
  enum PointerButton
  class RawPointer
  class Gesture
  class GestureRecognizer
  interface InputTarget
  class InputRouter
  GestureRecognizer ..> RawPointer
  GestureRecognizer ..> Gesture
  InputRouter o--> InputTarget
}

package scene {
  abstract class Drawable
  class Artboard
  class Rectangle
  class Line
  class Polyline
  class Ellipse
  class Path
  class Text
  Drawable ..> IRenderTarget
  Rectangle --|> Drawable
  Line --|> Drawable
  Polyline --|> Drawable
  Ellipse --|> Drawable
  Path --|> Drawable
  Text --|> Drawable
  Artboard o--> Drawable
}

package ui {
  class Property
  class KeyEvent
  abstract class InputController
  class Theme
  class Segment
  class RectangleSegment
  class CircleSegment
  class LabelSegment
  class AbstractSlider
  class Slider
  class Button
  class Checkbox
  class TextBox
  class Knob
  class ToggleSwitch
  class ProgressBar
  class ComboBox
  class TabView
  class ScrollView
  class LineGraph

  Segment --|> Drawable
  Segment ..|> InputTarget
  Segment *--> Property
  Segment o--> Segment
  Segment o--> InputController
  RectangleSegment --|> Segment
  CircleSegment --|> Segment
  LabelSegment --|> Segment
  Slider --|> Segment
  Slider --|> AbstractSlider
  Button --|> Segment
  Checkbox --|> Segment
  TextBox --|> Segment
  Knob --|> Segment
  Knob --|> AbstractSlider
  ToggleSwitch --|> Segment
  ProgressBar --|> Segment
  ComboBox --|> Segment
  TabView --|> Segment
  ScrollView --|> Segment
  LineGraph --|> Segment
  Theme ..> Slider
  Theme ..> Button
  Theme ..> Checkbox
  Theme ..> TextBox
  Theme ..> Knob
  Theme ..> ToggleSwitch
  Theme ..> ProgressBar
  Theme ..> ComboBox
  Theme ..> TabView
  Theme ..> ScrollView
  Theme ..> LineGraph
}

package "adapter/web" {
  class Canvas2DTarget
  Canvas2DTarget ..|> IRenderTarget
}

Segment ..> KeyEvent
Segment ..> Gesture
Segment ..> Transform
Property *--> AnimatedProperty

note right of Segment
Composite UI node.
Owns animated layout properties,
shared focus, and recursive input.
end note

note right of Slider
Concrete slider uses child segments:
track rectangle, fill rectangle, thumb circle.
end note

@enduml
