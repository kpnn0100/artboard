@startuml
title Arstro Artboard Architecture
skinparam classAttributeIconSize 0
hide empty members

package core {
  class Point
  class Size
  class Rect
  class Transform
  class Color
}

package anim {
  enum Easing {
    + Standard / StandardDecel / StandardAccel
    + EmphasizedDecel / EmphasizedAccel  ' cubic-bezier curves, FR-31
  }
  class "MotionTokens" as MotionTokens <<(F,#88c) named constants>> {
    + kDurationShort1..4 / Medium1..4 / Long1..4
    + kSpatialFast/Default/Slow
    + kEffectsFast/Default/Slow  ' Spring omega presets
  }
  class Animation
  class Tween
  class AnimatedProperty
  class Animator
  class Spring {
    + advance(dtSeconds, omega)
    + setTarget(t) / reset(v)
  }
  class ReducedMotion <<(F,#88c) free fns>> {
    + setReducedMotion(bool)
    + reducedMotion() : bool
  }
  Animation ..> Easing
  Tween ..> Easing
  AnimatedProperty *--> Tween
  Animator *--> Tween
  Spring ..> ReducedMotion
  AnimatedProperty ..> ReducedMotion
}

package render {
  interface IRenderTarget {
    +clipRect(x,y,w,h)
    +clipPath()
    +pushLayer(alpha) / popLayer()
    +setRadialFill(cx,cy,r,inner,outer)
    +setLinearFill(x0,y0,x1,y1,start,end)
    +drawText(text,x,y,sizePx,fontFamily,letterSpacingPx)
    +registerImage(rgba,w,h) : int
    +updateImage(id,rgba,w,h)
    +drawImage(id,dst)
    +releaseImage(id)
  }
  class RecordingTarget
  RecordingTarget ..|> IRenderTarget
}

package input {
  enum PointerButton
  class RawPointer
  class Gesture
  class GestureRecognizer
  interface InputTarget
  class InputRouter
  GestureRecognizer ..> RawPointer
  GestureRecognizer ..> Gesture
  InputRouter o--> InputTarget
}

package scene {
  abstract class Drawable
  class Artboard
  class Rectangle
  class Line
  class Polyline
  class Ellipse
  class Path
  class Text
  Drawable ..> IRenderTarget
  Rectangle --|> Drawable
  Line --|> Drawable
  Polyline --|> Drawable
  Ellipse --|> Drawable
  Path --|> Drawable
  Text --|> Drawable
  Artboard o--> Drawable
}

package ui {
  enum SnapEdge
  class Property
  class KeyEvent
  abstract class InputController
  class Theme
  class Interaction <<(F,#88c) free fns>> {
    + lerpColor / brighten
    + lerpPaint / lerpBox / hoverBox  ' one shared hover treatment (FR-24)
  }
  class Segment {
    + render() / renderOverlay()  ' 2nd pass: onOverlay, unclipped
    + raise()  ' move to end of parent children
    + isHovered() / hoverAmount()  ' animated hover factor (FR-24)
    + isHoverWithin()  ' self-or-descendant hover (containers)
    + {static} setHovered(seg) / hoveredSegment()
    # onPaint() / onOverlay()
  }
  class RectangleSegment
  class CircleSegment
  class LabelSegment
  class LinearLayout
  class Row
  class Column
  class AbstractSlider
  class ModBus
  class "Observable<T>" as Observable {
    + get() : T
    + set(value)  ' notifies only when it changes
    + observe(fn, fireNow=true)  ' state link; fireNow initialises in sync
  }
  class Slider {
    + onChange : (value)
    + setClickJumps(bool)
    + advance(nowMs)  ' spring-smoothed display
    + displayValue()
    + setTrackGradient(left,right)
    + setSubValueOffset(offset) / setSubValueColor(c)  ' reference reach
  }
  class Button
  class Checkbox
  class TextBox
  class Knob
  class ToggleSwitch
  class ProgressBar
  class ComboBox
  class TabView
  class ScrollView
  class LineGraph
  class ImageView

  Segment --|> Drawable
  Segment ..|> InputTarget
  Segment ..> SnapEdge
  Segment *--> Property
  Segment o--> Segment
  Segment o--> InputController
  RectangleSegment --|> Segment
  CircleSegment --|> Segment
  LabelSegment --|> Segment
  LinearLayout --|> Segment
  Row --|> LinearLayout
  Column --|> LinearLayout
  Slider --|> Segment
  Slider --|> AbstractSlider
  Button --|> Segment
  Checkbox --|> Segment
  TextBox --|> Segment
  Knob --|> Segment
  Knob --|> AbstractSlider
  Knob ..> ModBus
  Knob ..> Spring
  Slider ..> Spring
  ComboBox ..> AnimatedProperty
  ' animated state transitions (FR-25) + shared hover treatment (FR-24)
  Segment ..> Interaction
  Segment *--> Property : hoverAmount
  Button ..> Property
  Checkbox ..> Property
  TextBox ..> Property
  TabView ..> Property
  TabView ..> Spring
  ComboBox ..> Spring
  ScrollView ..> Spring
  ProgressBar ..> Spring
  LineGraph ..> Spring
  Interaction ..> Theme
  ToggleSwitch --|> Segment
  ProgressBar --|> Segment
  ComboBox --|> Segment
  TabView --|> Segment
  ScrollView --|> Segment
  LineGraph --|> Segment
  ImageView --|> Segment
  ImageView ..> IRenderTarget
  Theme ..> Slider
  Theme ..> Button
  Theme ..> Checkbox
  Theme ..> TextBox
  Theme ..> Knob
  Theme ..> ToggleSwitch
  Theme ..> ProgressBar
  Theme ..> ComboBox
  Theme ..> TabView
  Theme ..> ScrollView
  Theme ..> LineGraph
}

package "adapter/web" {
  class Canvas2DTarget
  Canvas2DTarget ..|> IRenderTarget
}

Segment ..> KeyEvent
Segment ..> Gesture
Segment ..> Transform
Property *--> AnimatedProperty

note right of Segment
Composite UI node.
Owns animated layout properties,
shared focus, hover (single global
owner + animated hoverAmount), and
recursive input. A bare Move routes
to the deepest handler under the pointer.
end note

note right of Slider
Concrete slider uses child segments:
track rectangle, fill rectangle, thumb circle.
end note

@enduml
