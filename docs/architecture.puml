@startuml
title Arstro Artboard Architecture
skinparam classAttributeIconSize 0
hide empty members

package core {
  class Point
  class Size
  class Rect
  class Transform
  class Color
}

package anim {
  enum Easing {
    + Standard / StandardDecel / StandardAccel
    + EmphasizedDecel / EmphasizedAccel  ' cubic-bezier curves, FR-31
  }
  class "MotionTokens" as MotionTokens <<(F,#88c) named constants>> {
    + kDurationShort1..4 / Medium1..4 / Long1..4
    + kSpatialFast/Default/Slow
    + kEffectsFast/Default/Slow  ' Spring omega presets
  }
  class Animation
  class Tween
  class AnimatedProperty
  class Animator
  class Spring {
    + advance(dtSeconds, omega)
    + setTarget(t) / reset(v)
  }
  class ReducedMotion <<(F,#88c) free fns>> {
    + setReducedMotion(bool)
    + reducedMotion() : bool
  }
  Animation ..> Easing
  Tween ..> Easing
  AnimatedProperty *--> Tween
  Animator *--> Tween
  Spring ..> ReducedMotion
  AnimatedProperty ..> ReducedMotion
}

package render {
  interface IRenderTarget {
    +clipRect(x,y,w,h)
    +clipPath()
    +pushLayer(alpha) / popLayer()
    +setRadialFill(cx,cy,r,inner,outer)
    +setLinearFill(x0,y0,x1,y1,start,end)
    +drawText(text,x,y,sizePx,fontFamily,letterSpacingPx)
    +registerImage(rgba,w,h) : int
    +updateImage(id,rgba,w,h)
    +drawImage(id,dst)
    +releaseImage(id)
  }
  class RecordingTarget
  RecordingTarget ..|> IRenderTarget
}

package input {
  enum PointerButton
  class RawPointer {
    + touch : bool  ' FR-28
  }
  class Gesture {
    + touch : bool
    + velocity : Point  ' set for Fling
  }
  class GestureRecognizer {
    + advance(nowMs)  ' long-press timeout + fling emission (FR-28)
    + setLongPressMs() / setFlingVelocityThreshold() / setVelocityWindowMs()
  }
  interface InputTarget
  class InputRouter
  GestureRecognizer ..> RawPointer
  GestureRecognizer ..> Gesture
  InputRouter o--> InputTarget
}

package scene {
  abstract class Drawable
  class Artboard
  class "Shapes" as Shapes <<(F,#88c) free fns>> {
    + drawRoundedRect() / drawCircle()
    + drawShadow() / drawElevation()  ' FR-30, gradient-composed soft shadow
  }
  Shapes ..> IRenderTarget
  class Rectangle
  class Line
  class Polyline
  class Ellipse
  class Path
  class Text
  Drawable ..> IRenderTarget
  Rectangle --|> Drawable
  Line --|> Drawable
  Polyline --|> Drawable
  Ellipse --|> Drawable
  Path --|> Drawable
  Text --|> Drawable
  Artboard o--> Drawable
}

package ui {
  enum SnapEdge
  class Property
  class KeyEvent
  abstract class InputController
  class Theme
  class Interaction <<(F,#88c) free fns>> {
    + lerpColor / brighten
    + lerpPaint / lerpBox / hoverBox  ' one shared hover treatment (FR-24)
  }
  class Segment {
    + opacity : Property  ' FR-32 group fade (pushLayer/popLayer)
    + rotation / scaleX / scaleY : Property  ' FR-33
    + pivotX / pivotY : Property  ' FR-33 rotate/scale about a local pivot
    + isFadedOut()  ' hidden or opacity<=eps: not drawn, not hit-tested
    + disabledAmount()  ' FR-40 animated dim factor
    + drawsBuiltInVisuals  ' FR-41 subclass supplies its own appearance
    + render() / renderOverlay()  ' 2nd pass: onOverlay, unclipped
    + raise()  ' move to end of parent children
    + isHovered() / hoverAmount()  ' animated hover factor (FR-24)
    + isHoverWithin()  ' self-or-descendant hover (containers)
    + {static} setHovered(seg) / hoveredSegment()
    # onPaint() / onOverlay()
    # onHoverChanged(b) / onFocusChanged(b)  ' FR-36 signal hooks
  }
  class RectangleSegment
  class CircleSegment
  class LabelSegment
  class Trim <<value>> {
    + start / end / offset  ' FR-42 fractions of arc length
    + active()
  }
  class PathSegment {
    + path : Path  ' FR-37 freeform geometry as an interactive node
    + trim : Trim  ' FR-42
    + clearPath()
  }
  class VisualLoop {
    + start(nowMs) / stop(nowMs)  ' FR-34 indeterminate lifecycle
    + setCycleMs(ms) / cyclePhase() / cycleCount()
    # onLoopStart() / onCycle(i) / onLoopEnd()
  }
  class ProgressIndicator {
    + setValue(v) / value() / displayValue()  ' FR-35 determinate state
    + setIndeterminate(on) / phase()
    # onValueChanged(v) / onComplete() / onIndeterminate() / onDeterminate()
  }
  class LinearLayout
  class Row
  class Column
  class AbstractSlider
  class ModBus
  class "Observable<T>" as Observable {
    + get() : T
    + set(value)  ' notifies only when it changes
    + observe(fn, fireNow=true)  ' state link; fireNow initialises in sync
  }
  class Slider {
    + onChange : (value)
    + setClickJumps(bool)
    + advance(nowMs)  ' spring-smoothed display
    + displayValue()
    + setTrackGradient(left,right)
    + setSubValueOffset(offset) / setSubValueColor(c)  ' reference reach
  }
  class Button
  class Checkbox
  class TextBox {
    + caret() / setCaret(b) / caretToEnd()  ' FR-38 caret editing
  }
  class Knob
  class ToggleSwitch
  class ProgressBar
  class ComboBox
  class TabView
  class ScrollView {
    + applyRubberBand(raw)  ' FR-29: compress excess past [0,maxOffset] instead of hard clamp
    + advance(nowMs)  ' fling decay -> Spring snap-back when out of range
  }
  class LineGraph
  class ImageView

  Segment --|> Drawable
  Segment ..|> InputTarget
  Segment ..> SnapEdge
  Segment *--> Property
  Segment o--> Segment
  Segment o--> InputController
  RectangleSegment --|> Segment
  CircleSegment --|> Segment
  LabelSegment --|> Segment
  PathSegment --|> Segment
  PathSegment *--> Path
  VisualLoop --|> Segment
  ProgressIndicator --|> Segment
  ProgressIndicator ..> Spring
  LinearLayout --|> Segment
  Row --|> LinearLayout
  Column --|> LinearLayout
  Slider --|> Segment
  Slider --|> AbstractSlider
  Button --|> Segment
  Checkbox --|> Segment
  TextBox --|> Segment
  Knob --|> Segment
  Knob --|> AbstractSlider
  Knob ..> ModBus
  Knob ..> Spring
  Slider ..> Spring
  ComboBox ..> AnimatedProperty
  ' animated state transitions (FR-25) + shared hover treatment (FR-24)
  Segment ..> Interaction
  Segment *--> Property : hoverAmount
  Button ..> Property
  Checkbox ..> Property
  TextBox ..> Property
  TabView ..> Property
  TabView ..> Spring
  ComboBox ..> Spring
  ScrollView ..> Spring
  LineGraph ..> Spring
  Interaction ..> Theme
  ToggleSwitch --|> Segment
  ProgressBar --|> ProgressIndicator
  ComboBox --|> Segment
  TabView --|> Segment
  ScrollView --|> Segment
  LineGraph --|> Segment
  ImageView --|> Segment
  ImageView ..> IRenderTarget
  Theme ..> Slider
  Theme ..> Button
  Theme ..> Checkbox
  Theme ..> TextBox
  Theme ..> Knob
  Theme ..> ToggleSwitch
  Theme ..> ProgressBar
  Theme ..> ComboBox
  Theme ..> TabView
  Theme ..> ScrollView
  Theme ..> LineGraph
}

package "adapter/web" {
  class Canvas2DTarget
  Canvas2DTarget ..|> IRenderTarget
}

Segment ..> KeyEvent
Segment ..> Gesture
Segment ..> Transform
Property *--> AnimatedProperty

note right of Segment
Composite UI node.
Owns animated layout properties,
shared focus, hover (single global
owner + animated hoverAmount), and
recursive input. A bare Move routes
to the deepest handler under the pointer.
end note

note right of Slider
Concrete slider uses child segments:
track rectangle, fill rectangle, thumb circle.
end note

@enduml
